<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Setup">

        <!-- No android:theme here, deliberately. It is accepted by the manifest
             parser and then ignored: InputMethodService.onCreate() calls
             super.setTheme() with its own field and overwrites it. The theme is
             applied in GlassKeyboardService's constructor instead, which is the
             only place that works. -->
        <service
            android:name=".GlassKeyboardService"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!--
            No LAUNCHER category on purpose: a keyboard has no business taking a
            slot in the app drawer. It is still exported and still MAIN, which is
            what lets Settings open it. res/xml/method.xml names this class as the
            input method's settingsActivity, so it appears under the keyboard's
            own entry in Languages and input.
        -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
