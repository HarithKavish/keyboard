# gradlew is executed by /bin/sh on the CI runner. Checked out with CRLF it
# fails with a "bad interpreter" error that names no obvious cause, so the line
# endings are pinned rather than left to each contributor's core.autocrlf.
* text=auto eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf

*.jar binary
*.png binary
*.apk binary
*.jks binary
